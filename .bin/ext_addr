#!/bin/bash

# A status-bar command must fail quickly when DNS or the uplink is down.
_cache_dir="${XDG_RUNTIME_DIR:-/tmp}"
_cache_file="${_cache_dir}/ext_addr-${UID}"
_max_age_minutes=10

_valid_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

if [[ -r "${_cache_file}" ]] && ! find "${_cache_file}" -mmin "+${_max_age_minutes}" -print -quit | grep -q .; then
    cat "${_cache_file}"
    exit 0
fi

for _endpoint in https://api.ipify.org https://checkip.amazonaws.com; do
    if _address="$(curl -4fsS --connect-timeout 2 --max-time 3 "${_endpoint}" 2>/dev/null)" && _valid_ipv4 "${_address}"; then
        umask 077
        _temporary="$(mktemp "${_cache_file}.XXXXXX")" || break
        printf '%s\n' "${_address}" > "${_temporary}"
        mv -f "${_temporary}" "${_cache_file}"
        printf '%s' "${_address}"
        exit 0
    fi
done

# Keep the status bar useful offline, but never wait indefinitely for the net.
if [[ -r "${_cache_file}" ]]; then
    cat "${_cache_file}"
    exit 0
fi

exit 1
