
# #######################################################################################
# AUTOGENERATED HYPRLAND CONFIG.
# PLEASE USE THE CONFIG PROVIDED IN THE GIT REPO /examples/hyprland.conf AND EDIT IT,
# OR EDIT THIS ONE ACCORDING TO THE WIKI INSTRUCTIONS.
# #######################################################################################

#autogenerated = 1 # remove this line to remove the warning

# This is an example Hyprland config file.
# Refer to the wiki for more information.
# https://wiki.hyprland.org/Configuring/

# Please note not all available settings / options are set here.
# For a full list, see the wiki

# You can split this configuration into multiple files
# Create your files separately and then link them to this file like this:
# source = ~/.config/hypr/myColors.conf


################
### MONITORS ###
################

# See https://wiki.hyprland.org/Configuring/Monitors/
monitor=,preferred,auto,1
monitor=eDP-1,preferred,auto,1.5


###################
### MY PROGRAMS ###
###################


# Set programs that you use
$terminal = kitty
$fileManager = dolphin
$menu = tofi-run | xargs hyprctl dispatch exec --


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

exec-once = hyprpaper
exec-once = hypridle
exec-once = hyprctl setcursor DMZ-Black 24
exec-once = dbus-update-activation-environment --all
exec-once = sleep 1 && dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = gsettings set org.gnome.desktop.interface cursor-theme "DMZ-Black"
exec-once = hyprpm reload -n
exec-once = ${HOME}/.bin/wlp


#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hyprland.org/Configuring/Environment-variables/

env = XCURSOR_THEME,DMZ-Black
env = XCURSOR_SIZE,24
env = HYPRCURSOR_THENE,DMZ-Black
env = HYPRCURSOR_SIZE,24
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland

env = QT_QPA_PLATFORM, wayland
env = QT_QPA_PLATFORMTHEME, kde


#####################
### LOOK AND FEEL ###
#####################

# Refer to https://wiki.hyprland.org/Configuring/Variables/

# https://wiki.hyprland.org/Configuring/Variables/#general
general {
    gaps_in = 5
    gaps_out = 10

    border_size = 2

    # https://wiki.hyprland.org/Configuring/Variables/#variable-types for info about colors
    col.active_border = rgba(33ccffee) rgba(00ff99ee) 45deg
    col.inactive_border = rgba(595959aa)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = true

    # Please see https://wiki.hyprland.org/Configuring/Tearing/ before you turn this on
    allow_tearing = false

    layout = dwindle
}

# https://wiki.hyprland.org/Configuring/Variables/#decoration
decoration {
    rounding = 5

    # Change transparency of focused and unfocused windows
    active_opacity = 1.0
    inactive_opacity = 0.9

    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }

    # https://wiki.hyprland.org/Configuring/Variables/#blur
    blur {
        enabled = true
        size = 3
        passes = 1

        vibrancy = 0.1696
    }
}

# https://wiki.hyprland.org/Configuring/Variables/#animations
animations {
    enabled = yes, please :)

    # Default animations, see https://wiki.hyprland.org/Configuring/Animations/ for more

    bezier = easeOutQuint,0.23,1,0.32,1
    bezier = easeInOutCubic,0.65,0.05,0.36,1
    bezier = linear,0,0,1,1
    bezier = almostLinear,0.5,0.5,0.75,1.0
    bezier = quick,0.15,0,0.1,1

    animation = global, 1, 10, default
    animation = border, 1, 5.39, easeOutQuint
    animation = windows, 1, 4.79, easeOutQuint
    animation = windowsIn, 1, 4.1, easeOutQuint, popin 87%
    animation = windowsOut, 1, 1.49, linear, popin 87%
    animation = fadeIn, 1, 1.73, almostLinear
    animation = fadeOut, 1, 1.46, almostLinear
    animation = fade, 1, 3.03, quick
    animation = layers, 1, 3.81, easeOutQuint
    animation = layersIn, 1, 4, easeOutQuint, fade
    animation = layersOut, 1, 1.5, linear, fade
    animation = fadeLayersIn, 1, 1.79, almostLinear
    animation = fadeLayersOut, 1, 1.39, almostLinear
    animation = workspaces, 1, 1.94, almostLinear, fade
    animation = workspacesIn, 1, 1.21, almostLinear, fade
    animation = workspacesOut, 1, 1.94, almostLinear, fade
}

# Ref https://wiki.hyprland.org/Configuring/Workspace-Rules/
# "Smart gaps" / "No gaps when only"
# uncomment all if you wish to use that.
# workspace = w[tv1], gapsout:0, gapsin:0
# workspace = f[1], gapsout:0, gapsin:0
# windowrulev2 = bordersize 0, floating:0, onworkspace:w[tv1]
# windowrulev2 = rounding 0, floating:0, onworkspace:w[tv1]
# windowrulev2 = bordersize 0, floating:0, onworkspace:f[1]
# windowrulev2 = rounding 0, floating:0, onworkspace:f[1]

# See https://wiki.hyprland.org/Configuring/Dwindle-Layout/ for more
dwindle {
#    pseudotile = true # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
    preserve_split = true # You probably want this
}

cursor {
    inactive_timeout = 0
}

# See https://wiki.hyprland.org/Configuring/Master-Layout/ for more
master {
    new_status = master
}

# https://wiki.hyprland.org/Configuring/Variables/#misc
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
#    vfr = 1
    vrr = 1
    mouse_move_enables_dpms = true
    key_press_enables_dpms = true
    animate_manual_resizes = false
    animate_mouse_windowdragging = false
    enable_swallow = false
    swallow_regex = (foot|kitty|allacritty|Alacritty)
    allow_session_lock_restore = true
    initial_workspace_tracking = false
    focus_on_activate = true
}


#############
### INPUT ###
#############

# https://wiki.hyprland.org/Configuring/Variables/#input
input {
    kb_layout = lv,ru
    kb_variant = ,winkeys
    kb_model =
    kb_options = grp:caps_toggle,lv3:ralt,compose:menu
    kb_rules =

    follow_mouse = 2

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = true
    }
}

xwayland {
    force_zero_scaling = true
}

gesture = 4, horizontal, workspace

# Example per-device config
# See https://wiki.hyprland.org/Configuring/Keywords/#per-device-input-configs for more
device {
    name = epic-mouse-v1
    sensitivity = -0.5
}

binds {
    scroll_event_delay = 0
    hide_special_on_workspace_change = true
}


###################
### KEYBINDINGS ###
###################

# See https://wiki.hyprland.org/Configuring/Keywords/
$mainMod = SUPER # Sets "Windows" key as main modifier


# Example binds, see https://wiki.hyprland.org/Configuring/Binds/ for more
bind = $mainMod, Return, exec, $terminal
bind = SHIFT$mainMod, Return, exec, hyprlock
bind = SHIFT$mainMod, Escape, exit,
bind = $mainMod, W, killactive,
bind = SHIFT$mainMod, W, forcekillactive
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, S, togglefloating,
bind = SHIFT$mainMod, S, exec, hyprshot -o ~/.scrs/ -m region
bind = $mainMod, F, fullscreen
bind = $mainMod, Space, exec, $menu
bind = $mainMod, T, pseudo, # dwindle
#bind = $mainMod, J, togglesplit, # dwindle
bind = $mainMod, Z, exec, notify-send -a "Time" "Current time" "$(date '+%d.%m.%y %H:%M:%S')"
bind = $mainMod, Grave, focuscurrentorlast,

# Move focus with mainMod + arrow keys
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

bind = $mainMod, 1, submap, Mon1

submap = Mon1

binde = , 1, workspace, 1
binde = , 1, submap, reset
binde = , 2, workspace, 2
binde = , 2, submap, reset
binde = , 3, workspace, 3
binde = , 3, submap, reset
binde = , 4, workspace, 4
binde = , 4, submap, reset
binde = , 5, workspace, 5
binde = , 5, submap, reset
binde = , 6, workspace, 6
binde = , 6, submap, reset
binde = , 7, workspace, 7
binde = , 7, submap, reset
binde = , 8, workspace, 8
binde = , 8, submap, reset
binde = , 9, workspace, 9
binde = , 9, submap, reset

submap = reset

bind = $mainMod SHIFT, 1, submap, Mon1Move

submap = Mon1Move

binde = , 1, movetoworkspace, 1
binde = , 1, submap, reset
binde = , 2, movetoworkspace, 2
binde = , 2, submap, reset
binde = , 3, movetoworkspace, 3
binde = , 3, submap, reset
binde = , 4, movetoworkspace, 4
binde = , 4, submap, reset
binde = , 5, movetoworkspace, 5
binde = , 5, submap, reset
binde = , 6, movetoworkspace, 6
binde = , 6, submap, reset
binde = , 7, movetoworkspace, 7
binde = , 7, submap, reset
binde = , 8, movetoworkspace, 8
binde = , 8, submap, reset
binde = , 9, movetoworkspace, 9
binde = , 9, submap, reset

submap = reset

bind = $mainMod, 2, submap, Mon2

submap = Mon2

binde = , 1, workspace, 11
binde = , 1, submap, reset
binde = , 2, workspace, 12
binde = , 2, submap, reset
binde = , 3, workspace, 13
binde = , 3, submap, reset
binde = , 4, workspace, 14
binde = , 4, submap, reset
binde = , 5, workspace, 15
binde = , 5, submap, reset
binde = , 6, workspace, 16
binde = , 6, submap, reset
binde = , 7, workspace, 17
binde = , 7, submap, reset
binde = , 8, workspace, 18
binde = , 8, submap, reset
binde = , 9, workspace, 19
binde = , 9, submap, reset

submap = reset

bind = $mainMod SHIFT, 2, submap, Mon2Move

submap = Mon2Move

binde = , 1, movetoworkspace, 11
binde = , 1, submap, reset
binde = , 2, movetoworkspace, 12
binde = , 2, submap, reset
binde = , 3, movetoworkspace, 13
binde = , 3, submap, reset
binde = , 4, movetoworkspace, 14
binde = , 4, submap, reset
binde = , 5, movetoworkspace, 15
binde = , 5, submap, reset
binde = , 6, movetoworkspace, 16
binde = , 6, submap, reset
binde = , 7, movetoworkspace, 17
binde = , 7, submap, reset
binde = , 8, movetoworkspace, 18
binde = , 8, submap, reset
binde = , 9, movetoworkspace, 19
binde = , 9, submap, reset

submap = reset

bind = $mainMod, 3, submap, Mon3

submap = Mon3

binde = , 1, workspace, 21
binde = , 1, submap, reset
binde = , 2, workspace, 22
binde = , 2, submap, reset
binde = , 3, workspace, 23
binde = , 3, submap, reset
binde = , 4, workspace, 24
binde = , 4, submap, reset
binde = , 5, workspace, 25
binde = , 5, submap, reset
binde = , 6, workspace, 26
binde = , 6, submap, reset
binde = , 7, workspace, 27
binde = , 7, submap, reset
binde = , 8, workspace, 28
binde = , 8, submap, reset
binde = , 9, workspace, 29
binde = , 9, submap, reset

submap = reset

bind = $mainMod SHIFT, 3, submap, Mon3Move

submap = Mon3Move

binde = , 1, movetoworkspace, 21
binde = , 1, submap, reset
binde = , 2, movetoworkspace, 22
binde = , 2, submap, reset
binde = , 3, movetoworkspace, 23
binde = , 3, submap, reset
binde = , 4, movetoworkspace, 24
binde = , 4, submap, reset
binde = , 5, movetoworkspace, 25
binde = , 5, submap, reset
binde = , 6, movetoworkspace, 26
binde = , 6, submap, reset
binde = , 7, movetoworkspace, 27
binde = , 7, submap, reset
binde = , 8, movetoworkspace, 28
binde = , 8, submap, reset
binde = , 9, movetoworkspace, 29
binde = , 9, submap, reset

submap = reset

# Switch workspaces with mainMod + [0-9]
#bind = $mainMod, 1, workspace, 1
#bind = $mainMod, 2, workspace, 2
#bind = $mainMod, 3, workspace, 3
#bind = $mainMod, 4, workspace, 4
#bind = $mainMod, 5, workspace, 5
#bind = $mainMod, 6, workspace, 6
#bind = $mainMod, 7, workspace, 7
#bind = $mainMod, 8, workspace, 8
#bind = $mainMod, 9, workspace, 9
#bind = $mainMod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
#bind = $mainMod SHIFT, 1, movetoworkspace, 1
#bind = $mainMod SHIFT, 2, movetoworkspace, 2
#bind = $mainMod SHIFT, 3, movetoworkspace, 3
#bind = $mainMod SHIFT, 4, movetoworkspace, 4
#bind = $mainMod SHIFT, 5, movetoworkspace, 5
#bind = $mainMod SHIFT, 6, movetoworkspace, 6
#bind = $mainMod SHIFT, 7, movetoworkspace, 7
#bind = $mainMod SHIFT, 8, movetoworkspace, 8
#bind = $mainMod SHIFT, 9, movetoworkspace, 9
#bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Example special workspace (scratchpad)
#bind = $mainMod, S, togglespecialworkspace, magic
#bind = $mainMod SHIFT, S, movetoworkspace, special:magic

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Laptop multimedia keys for volume and LCD brightness
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl s 10%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl s 10%-

# Requires playerctl
bindel = CTRL, Up, exec, ~/.bin/media_buttons.sh toggle
bindel = CTRL, Right, exec, ~/.bin/media_buttons.sh next
bindel = CTRL, Left, exec, ~/.bin/media_buttons.sh prev
bindl = , XF86AudioNext, exec, ~/.bin/media_buttons.sh next
bindl = , XF86AudioPause, exec, ~/.bin/media_buttons.sh toggle
bindl = , XF86AudioPlay, exec, ~/.bin/media_buttons.sh toggle
bindl = , XF86AudioPrev, exec, ~/.bin/media_buttons.sh prev

##############################
### WINDOWS AND WORKSPACES ###
##############################

# See https://wiki.hyprland.org/Configuring/Window-Rules/ for more
# See https://wiki.hyprland.org/Configuring/Workspace-Rules/ for workspace rules

# Example windowrule v1
# windowrule = float, ^(kitty)$

# Example windowrule v2
# windowrulev2 = float,class:^(kitty)$,title:^(kitty)$

# Ignore maximize requests from apps. You'll probably like this.

windowrule = float 1, match:class ^(org.pulseaudio.pavucontrol)$
windowrule = size 30% 50%, match:class ^(org.pulseaudio.pavucontrol)$
windowrule = stay_focused 1,  match:class (pinentry-)(.*)
windowrule = stay_focused 1,  match:class Rofi
windowrule = float 1, match:modal true
# Fix some dragging issues with XWayland
# No shadow for tiled windows (matches windows that are not floating).
windowrule = no_shadow 1, match:float 0
windowrule = focus_on_activate 0, match:class ^org\.telegram\.desktop.*$
windowrule = float 1, match:class ^pgmodeler$
windowrule = tile 1, match:class ^pgmodeler$, match:title ^pgModeler
